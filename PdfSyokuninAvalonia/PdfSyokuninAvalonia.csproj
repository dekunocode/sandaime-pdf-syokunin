<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfSyokunin</RootNamespace>
    <AssemblyName>三代目PDF職人</AssemblyName>
    <Version>1.2.0</Version>
    <Product>三代目PDF職人</Product>
    <Authors>dekunocode</Authors>
    <Copyright>Copyright (c) 2026 dekunocode</Copyright>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- IDEの通常復元でもRelease用win-x64資産を失わないよう常にRIDを解決する。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 起動時のコンパイルを先に済ませて起動を速くする。圧縮と組み合わせると、大きさと速さの釣り合いがよい
         （GitHub Actions での実測: 2回目以降の起動 1.6秒 → 0.8秒、exe 56MB → 74MB）。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <Target Name="RemoveNativeSymbolsFromPublishedOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedNativeSymbols Include="$(PublishDir)libSkiaSharp.pdb" />
      <PublishedNativeSymbols Include="$(PublishDir)libHarfBuzzSharp.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedNativeSymbols)" />
  </Target>
</Project>
