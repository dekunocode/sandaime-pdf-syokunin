<Window x:Class="PdfSyokunin.Views.PasswordPromptWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保護されたPDF" Width="430" Height="230"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20,16" RowDefinitions="Auto,Auto,66,*">
    <TextBlock Text="このPDFはパスワードで保護されています" FontSize="17" FontWeight="SemiBold" />
    <TextBlock x:Name="FileNameText" Grid.Row="1" Margin="0,6,0,0" Classes="muted" TextTrimming="CharacterEllipsis" />
    <TextBox x:Name="PasswordInput" Grid.Row="2" Margin="0,12,0,4" PlaceholderText="PDFを開くパスワード"
             PasswordChar="●" KeyDown="PasswordInput_OnKeyDown" />
    <Grid Grid.Row="3">
      <TextBlock x:Name="ValidationText" Foreground="#FF8A80" FontSize="11"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,170,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="キャンセル" Classes="compact" Click="Cancel_OnClick" />
        <Button Content="開く" Classes="primary" MinWidth="82" Click="Open_OnClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
