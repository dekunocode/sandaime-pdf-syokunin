<UserControl x:Class="PdfSyokunin.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,4,0" Spacing="10">
      <Border Classes="card">
        <Grid ColumnDefinitions="48,*">
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="#43C6F5" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{DynamicResource Settings_Libraries}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LibraryDescription}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Settings_LibrariesNote}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Expander Header="{DynamicResource Settings_Licenses}">
        <TextBox Text="{Binding ThirdPartyNotices, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" MaxHeight="240" FontFamily="Consolas" FontSize="10" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
